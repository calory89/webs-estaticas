  {
   "@id": "https://kolaboro.com/data/#live-findings",
   "@type": "dcat:Dataset",
   "dct:identifier": "live-findings",
   "dct:title": "Live findings from developer pages",
   "dct:description": "Once a day a scheduled job re-reads the developer pages of the tracked projects that were checked longest ago and publishes a finding only when a fact (handover date, price, permit number) is new or changed, with the SHA-256 of the exact quote, checked word for word in code. Anonymous: project id and market only. Its running cost is capped at 0.25 USD a day for all runs together (until 6 Nov 2026 the job ran every hour on a larger budget).",
   "dcat:keyword": [
    "findings",
    "developer pages",
    "changes"
   ],
   "dct:publisher": {
    "@id": "https://kolaboro.com/#org"
   },
