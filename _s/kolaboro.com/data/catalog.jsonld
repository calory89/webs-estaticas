 "dcat:dataset": [
  {
   "@id": "https://kolaboro.com/data/#bali-cases",
   "@type": "dcat:Dataset",
   "dct:identifier": "bali-cases",
   "dct:title": "Tracked off-plan projects (anonymous)",
   "dct:description": "Every off-plan project Kolaboro tracks, one record per anonymous project id: market, country, stage, price band, promised handover year, the six public checks (permit, deposit protection, progress, plans, track record, no guaranteed returns), how far each is confirmed, claims tested, flags and the change history. Advertised claims, not verified facts. The same data is served filtered by /api/open/projects.",
   "dcat:keyword": [
    "off-plan",
    "property",
    "due diligence",
    "developers",
    "transparency"
   ],
   "dct:publisher": {
    "@id": "https://kolaboro.com/#org"
   },
   "dct:license": {
    "@id": "https://creativecommons.org/licenses/by/4.0/"
   },
   "dct:rights": "CC BY 4.0 (credit: Kolaboro, kolaboro.com)",
