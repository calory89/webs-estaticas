{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Kolaboro X-ray",
  "version": "2.2.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://kolaboro.com/extension/",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_action__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.idealista.com/*",
        "https://*.idealista.pt/*",
        "https://*.idealista.it/*",
        "https://*.fotocasa.es/*",
        "https://*.propertyfinder.ae/*",
        "https://*.propertyfinder.bh/*",
        "https://*.propertyfinder.eg/*",
        "https://*.propertyfinder.qa/*",
        "https://*.propertyfinder.sa/*",
        "https://*.bayut.com/*",
        "https://*.bayut.sa/*",
        "https://*.bayut.eg/*",
        "https://*.rightmove.co.uk/*",
        "https://*.zillow.com/*",
        "https://*.kyero.com/*",
        "https://*.propertyguru.com.sg/*",
        "https://*.propertyguru.com.my/*",
        "https://*.ddproperty.com/*",
        "https://*.fazwaz.com/*",
        "https://*.rumah123.com/*"
      ],
      "js": [
        "i18n.js",
        "kx.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/mail/*"
      ],
      "js": [
        "i18n.js",
        "kx.js",
        "mailcheck.js",
        "mail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://kolaboro.com"
  }
}
