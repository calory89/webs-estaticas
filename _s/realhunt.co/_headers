
# Home photos and their thumbnails (ronda 15 of RealHunt 100/100): a new photo gets a new name, so a browser may keep
# one for a day and use it for a week while it checks in the background, instead of asking again on every visit.
/finds/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/t/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
