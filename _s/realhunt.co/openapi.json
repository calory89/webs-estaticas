  "/homes/{country}": {
   "get": {
    "operationId": "getCountryPage",
    "summary": "The page of a country: every home, prices, rules and questions (HTML, readable without JavaScript)",
    "parameters": [
     {
      "name": "country",
      "in": "path",
      "required": true,
      "description": "Country key: lower case, words joined with a hyphen.",
      "schema": {
       "type": "string",
       "enum": [
        "spain",
        "italy",
        "united-states",
        "france",
