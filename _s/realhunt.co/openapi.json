{
 "openapi": "3.1.0",
 "info": {
  "title": "RealHunt open data",
  "version": "2026-11-27",
  "summary": "Cheap homes for sale around the world, each checked by a person and scored, with buying rules and costs by country.",
  "description": "Read-only static files, rebuilt with every update of the site (at least daily). No key is needed. Text and figures are licensed CC BY 4.0: quote them with a link to the page they come from. Photos belong to the original listings and are not part of these files. Rules, taxes and costs are general information, not legal or tax advice. Human-readable documentation: https://realhunt.co/research/open-data",
  "license": {
   "name": "CC BY 4.0",
   "url": "https://creativecommons.org/licenses/by/4.0/"
  },
  "contact": {
   "name": "RealHunt",
   "email": "carlos@equinoxinvestmentgroup.com",
   "url": "https://realhunt.co/research/open-data"
  }
 },
 "servers": [
  {
   "url": "https://realhunt.co"
  }
 ],
 "externalDocs": {
  "description": "For AI assistants: what to quote and how to attribute",
  "url": "https://realhunt.co/for-ai"
 },
 "paths": {
  "/data/countries/index.json": {
   "get": {
    "operationId": "listCountries",
    "summary": "Countries with homes, their key figures and the address of each country file",
    "responses": {
     "200": {
      "description": "The index",
      "content": {
       "application/json": {}
      }
     }
    }
   }
  },
  "/data/countries/{country}.json": {
   "get": {
    "operationId": "getCountry",
    "summary": "Key facts, buying rules and every home of one country",
    "description": "To search, read this file and filter `homes` by price_eur, size_sqm, bedrooms or score. Example: homes in Bulgaria up to 30,000 euros = getCountry(bulgaria), then price_eur <= 30000.",
    "parameters": [
     {
      "name": "country",
      "in": "path",
      "required": true,
      "description": "Country key: lower case, words joined with a hyphen.",
      "schema": {
       "type": "string",
       "enum": [
        "spain",
        "italy",
        "united-states",
        "france",
        "denmark",
        "sweden",
        "japan",
        "poland",
        "greece",
        "germany",
        "portugal",
        "netherlands",
        "canada",
        "mexico",
        "switzerland",
        "bulgaria",
        "united-kingdom",
        "cyprus",
        "dominican-republic",
        "ireland",
        "uruguay",
        "colombia",
        "czech-republic",
        "slovenia"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The country",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "country": {
           "type": "string"
          },
          "updated": {
           "type": "string",
           "format": "date"
          },
          "sentences": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "description": "Dated sentences that can be quoted on their own."
          },
          "summary": {
           "type": "object"
          },
          "buying": {
           "type": "object"
          },
          "pages": {
           "type": "object"
          },
          "homes": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Home"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/data/countries/{country}.md": {
   "get": {
    "operationId": "getCountryText",
    "summary": "The same country as clean text (Markdown), each home with its description. Spanish: {country}.es.md",
    "parameters": [
     {
      "name": "country",
      "in": "path",
      "required": true,
      "description": "Country key: lower case, words joined with a hyphen.",
      "schema": {
       "type": "string",
       "enum": [
        "spain",
        "italy",
        "united-states",
        "france",
        "denmark",
        "sweden",
        "japan",
        "poland",
        "greece",
        "germany",
        "portugal",
        "netherlands",
        "canada",
        "mexico",
        "switzerland",
        "bulgaria",
        "united-kingdom",
        "cyprus",
        "dominican-republic",
        "ireland",
        "uruguay",
        "colombia",
        "czech-republic",
        "slovenia"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Markdown",
      "content": {
       "text/markdown": {}
      }
     }
    }
   }
  },
