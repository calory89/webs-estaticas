        "switzerland",
        "bulgaria",
        "united-kingdom",
        "cyprus",
        "dominican-republic",
        "ireland",
        "uruguay",
        "colombia",
        "czech-republic",
        "slovenia"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "PDF",
      "content": {
       "application/pdf": {}
      }
     }
    }
   }
  },
  "/research/homes.csv": {
   "get": {
    "operationId": "getHomesCsv",
