  "/research/find-homes": {
   "get": {
    "operationId": "findHomes",
    "summary": "Search page for people and agents with a browser: filters the homes of a country by price, size and bedrooms",
    "description": "Needs JavaScript. Without it, use getCountry and filter the list yourself; the page says so and links the files.",
    "parameters": [
     {
      "name": "country",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "spain",
        "italy",
        "united-states",
        "france",
        "denmark",
        "sweden",
        "japan",
        "poland",
        "greece",
        "germany",
        "portugal",
        "netherlands",
        "canada",
        "mexico",
        "switzerland",
        "bulgaria",
        "united-kingdom",
        "cyprus",
        "dominican-republic",
        "ireland",
        "uruguay",
        "colombia",
        "czech-republic",
        "slovenia"
       ]
      }
     },
     {
      "name": "max",
      "in": "query",
      "description": "Highest price in euros",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "min",
      "in": "query",
      "description": "Lowest price in euros",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "beds",
      "in": "query",
      "description": "Fewest bedrooms",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "sqm",
      "in": "query",
      "description": "Smallest size in m²",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "HTML",
      "content": {
       "text/html": {}
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Home": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "format": "uri"
     },
     "title": {
      "type": "string"
     },
     "title_es": {
      "type": [
       "string",
       "null"
      ],
      "description": "The title in Spanish, when there is one."
     },
     "country": {
      "type": [
       "string",
       "null"
      ]
     },
     "region": {
      "type": [
       "string",
       "null"
      ]
     },
     "place": {
      "type": [
       "string",
       "null"
      ]
     },
     "price_eur": {
      "type": "number",
      "description": "Asking price in euros from the original listing."
     },
     "size_sqm": {
      "type": [
       "number",
       "null"
      ]
     },
     "bedrooms": {
      "type": [
       "number",
       "null"
      ]
     },
     "score": {
      "type": [
       "number",
       "null"
      ],
      "description": "RealHunt score, 70 to 98. RealHunt's own grade, not a valuation."
     },
     "added": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "lat": {
      "type": [
       "number",
       "null"
      ]
     },
     "lng": {
      "type": [
       "number",
       "null"
      ]
     },
     "listed_on": {
      "type": [
       "string",
       "null"
      ],
      "description": "Domain of the original listing."
     },
     "summary": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "HomeLine": {
    "type": "object",
    "required": [
     "url",
     "slug",
     "price_eur",
     "state"
    ],
    "properties": {
     "url": {
      "type": "string",
      "format": "uri"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "title_es": {
      "type": [
       "string",
       "null"
      ]
     },
     "country": {
      "type": [
       "string",
       "null"
      ]
     },
     "region": {
      "type": [
       "string",
       "null"
      ]
     },
     "place": {
      "type": [
       "string",
       "null"
      ]
     },
     "lat": {
      "type": [
       "number",
       "null"
      ],
      "description": "Rounded to 3 decimals (about 100 m)."
     },
     "lng": {
      "type": [
       "number",
       "null"
      ],
      "description": "Rounded to 3 decimals (about 100 m)."
     },
     "price_eur": {
      "type": "number"
     },
     "size_sqm": {
      "type": [
       "number",
       "null"
      ]
     },
     "eur_per_sqm": {
      "type": [
       "number",
       "null"
      ]
     },
     "bedrooms": {
      "type": [
       "number",
       "null"
      ]
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "score_summary": {
      "type": [
       "string",
       "null"
      ]
     },
     "added": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "state": {
      "type": "string",
      "enum": [
       "listed",
       "unconfirmed",
       "advert_offline"
      ]
     },
     "listed_on": {
      "type": [
       "string",
       "null"
      ]
     },
     "monthly_fee": {
      "type": [
       "number",
       "null"
      ],
      "description": "Community fee (HOA) per month as the listing states it, in costs_currency."
     },
     "yearly_tax": {
      "type": [
       "number",
       "null"
      ],
      "description": "Property tax per year as the listing states it, in costs_currency."
     },
     "costs_currency": {
      "type": [
       "string",
       "null"
      ]
     },
     "fee_unknown": {
      "type": "boolean",
      "description": "A flat whose listing does not state its community fee."
     },
     "flood_indicator": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "low",
       "medium",
       "high",
       null
      ],
      "description": "Rough indicator from height and distance to the sea and rivers, not an official flood map."
     },
     "noise_indicator": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "low",
       "medium",
       "high",
       null
      ],
      "description": "From the distance to motorways and railways (OpenStreetMap)."
     },
     "airport_km": {
      "type": [
       "number",
       "null"
      ]
     },
     "last_confirmed": {
      "type": [
       "string",
       "null"
      ],
      "format": "date",
      "description": "Last day our nightly check read the advert as still for sale (src_ok_at)."
     }
    }
   }
  }
 }
}
