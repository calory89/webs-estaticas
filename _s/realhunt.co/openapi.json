  "/data/homes.jsonl": {
   "get": {
    "operationId": "getHomesJsonl",
    "summary": "Every home, one JSON object per line. The first line describes the file (_about, updated, license); every other line is a HomeLine",
    "description": "Read it line by line and skip the first. Example: curl -s https://realhunt.co/data/homes.jsonl | tail -n +2 | jq -c 'select(.price_eur <= 30000)'",
    "responses": {
     "200": {
      "description": "JSON Lines",
      "content": {
       "application/jsonl": {
        "schema": {
         "$ref": "#/components/schemas/HomeLine"
        }
       }
      }
     }
    }
   }
  },
  "/data/homes.csv": {
   "get": {
    "operationId": "getHomesCsvAll",
    "summary": "The same homes and fields as homes.jsonl, one row each (UTF-8 with BOM). Fields: https://realhunt.co/data/README.md",
    "responses": {
     "200": {
      "description": "CSV",
      "content": {
       "text/csv": {}
      }
     }
    }
   }
  },
  "/data/countries.json": {
   "get": {
    "operationId": "getCountriesAll",
    "summary": "Every country in one file: homes, median price, cheapest, buying costs and the rule for foreign buyers, with sources",
    "responses": {
     "200": {
      "description": "JSON",
      "content": {
       "application/json": {}
      }
     }
    }
   }
  },
  "/data/costs.json": {
