/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/hlc/fx.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/panel/*
  X-Robots-Tag: noindex, nofollow

/hlc/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/hlc/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/hlc/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/hlc/brand/*
  Cache-Control: public, max-age=604800

/wp-content/uploads/*
  Cache-Control: public, max-age=2592000

/chollos/:slug/og.jpg
  Cache-Control: public, max-age=604800

/chollos/feed.json
  Cache-Control: public, max-age=900
  Access-Control-Allow-Origin: *

/chollos/llms-full.txt
  Cache-Control: public, max-age=900
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/favicon.ico
  Cache-Control: public, max-age=604800

/hlc/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/destinos/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/en/destinations/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/vuelos/rutas.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/en/flights/routes.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/vuelos/feed.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/en/flights/feed.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/vuelos/*.csv
  Content-Type: text/csv; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/.well-known/ai.txt
  Content-Type: text/plain; charset=utf-8

/chollos/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/en/deals/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/en/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/es/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.txt
  X-Robots-Tag: max-snippet:-1

/guias/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/en/guides/*/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/:page/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/en/:page/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
